# Copy to .env and fill in. .env is gitignored.
#
# Each environment needs HOST, CLIENT_ID and CLIENT_SECRET, using the environment
# name you'll reference in job files ("source": "dev", "destination": "sit").
#
# HOST:       SitecoreAI Deploy > Projects > <project> > Authoring environments
#             > <environment> > Details > Environment host name
# CLIENT_ID/  SitecoreAI Deploy > Credentials > Environment > Create credentials
# SECRET:     > Automation (Organization Admin/Owner required)

SITECORE_DEV_HOST=xmc-xxxxxxxx-dev.sitecorecloud.io
SITECORE_DEV_CLIENT_ID=
SITECORE_DEV_CLIENT_SECRET=

SITECORE_SIT_HOST=xmc-xxxxxxxx-sit.sitecorecloud.io
SITECORE_SIT_CLIENT_ID=
SITECORE_SIT_CLIENT_SECRET=

SITECORE_PROD_HOST=xmc-xxxxxxxx-prod.sitecorecloud.io
SITECORE_PROD_CLIENT_ID=
SITECORE_PROD_CLIENT_SECRET=

# Optional. Destinations that require typing the environment name to confirm.
# Comma-separated; defaults to PROD. Set to empty to disable.
# SITECORE_PROTECTED_ENVS=PROD

# Optional. Only change these if Sitecore tells you to.
# SITECORE_AUTH_URL=https://auth.sitecorecloud.io/oauth/token
# SITECORE_AUTH_AUDIENCE=https://api.sitecorecloud.io
